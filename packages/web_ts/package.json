{
  "name": "@celestia-island/kirino",
  "version": "0.9.5",
  "description": "Client-side auth utilities for kirino — JWT validation, session storage fallback, auth-lost handling, and the generated login-policy contract types",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-extensions.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/celestia-island/kirino.git",
    "directory": "packages/web_ts"
  },
  "keywords": [
    "kirino",
    "auth",
    "jwt",
    "session"
  ],
  "license": "SySL-1.0",
  "devDependencies": {
    "typescript": "^*",
    "vitest": "^*"
  }
}
